FLASK_ENV=production
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET-too
LOG_LEVEL=INFO
LOG_FORMAT=text

# Leave commented out to fall back to SQLite (dev.db) for local development.
# Required in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Used for rate-limit storage. Falls back to in-memory, which is fine for a
# single dev process but NOT for multiple gunicorn workers in production.
# REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=https://tjtutoring.academy,https://www.tjtutoring.academy
NOTIFY_EMAIL=hello@tjtutoring.academy
# Optional email notifications for contact enquiries and tutor applications.
# Configure these in your hosting environment; never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=hello@tjtutoring.academy
